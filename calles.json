<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TuMovil - Panel de Control</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body, html {
            height: 100%;
            width: 100%;
            background-color: #121212;
            color: #ffffff;
            display: flex;
            flex-direction: column;
        }
        #map {
            height: 45vh;
            width: 100%;
            z-index: 1;
        }
        .panel-control {
            flex: 1;
            background: #1e1e1e;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding: 15px;
            box-shadow: 0 -4px 10px rgba(0,0,0,0.5);
            overflow-y: auto;
            z-index: 10;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .tarifa-card {
            background: #2a2a2a;
            border: 1px solid #3d3d3d;
            border-radius: 12px;
            padding: 12px 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .tarifa-card.selected {
            border-color: #00e676;
            background: #1a3322;
        }
        .input-group {
            position: relative;
            background: #2a2a2a;
            border: 1px solid #3d3d3d;
            border-radius: 10px;
            padding: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .input-group input {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 16px;
            width: 100%;
            outline: none;
        }
        .sugerencias-lista {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #2a2a2a;
            border: 1px solid #3d3d3d;
            border-radius: 0 0 10px 10px;
            max-height: 150px;
            overflow-y: auto;
            z-index: 100;
            display: none;
        }
        .sugerencia-item {
            padding: 10px;
            font-size: 14px;
            border-bottom: 1px solid #333;
            cursor: pointer;
        }
        .sugerencia-item:hover {
            background: #333;
        }
        .btn-confirmar {
            background: #00e676;
            color: #121212;
            border: none;
            padding: 15px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            text-align: center;
            cursor: pointer;
            margin-top: auto;
        }
        .btn-confirmar:hover {
            background: #00c853;
        }
    </style>
</head>
<body>

    <div id="map"></div>

    <div class="panel-control">
        <div class="tarifa-card selected">
            <div>
                <strong>Tu Móvil</strong>
                <div style="font-size: 12px; color: #aaa;">Base $3,000 + $600 x Km</div>
            </div>
            <div style="color: #00e676; font-weight: bold;">Tarifa Activa</div>
        </div>

        <!-- Buscador de origen -->
        <div class="input-group">
            <span style="color: #00e676;">🟢</span>
            <input type="text" id="origen-input" placeholder="¿Dónde estás? (Ej: Solano, Murillo...)" autocomplete="off">
            <div id="origen-sugerencias" class="sugerencias-lista"></div>
        </div>

        <!-- Buscador de destino -->
        <div class="input-group">
            <span style="color: #ff5252;">🔴</span>
            <input type="text" id="destino-input" placeholder="¿A dónde vas? (Ej: Magdalena, Fray Luis...)" autocomplete="off">
            <div id="destino-sugerencias" class="sugerencias-lista"></div>
        </div>

        <button class="btn-confirmar" onclick="confirmarViaje()">Confirmar Tu Móvil</button>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Base de datos de las 38 paradas reales de Trujui
        const paradasTrujui = [
            { nombre: "Solano López y San Emilio", lat: -34.5855, lng: -58.7512 },
            { nombre: "Solano López y Namuncurá", lat: -34.5862, lng: -58.7525 },
            { nombre: "Solano López y Magdalena", lat: -34.5870, lng: -58.7538 },
            { nombre: "Solano López (Tramo Intermedio)", lat: -34.5878, lng: -58.7545 },
            { nombre: "Solano López y Fray Luis León", lat: -34.5885, lng: -58.7552 },
            { nombre: "Solano López y Leprati", lat: -34.5892, lng: -58.7560 },
            { nombre: "Solano López y Oribe", lat: -34.5900, lng: -58.7571 },
            { nombre: "Solano López y Puccini", lat: -34.5910, lng: -58.7585 },
            { nombre: "Murillo y San Emilio", lat: -34.5840, lng: -58.7500 },
            { nombre: "Murillo y Namuncurá", lat: -34.5848, lng: -58.7513 },
            { nombre: "Murillo y Magdalena", lat: -34.5856, lng: -58.7526 },
            { nombre: "Fray Luis León y Don Bosco", lat: -34.5830, lng: -58.7480 },
            { nombre: "Fray Luis León y Ricardo Güiraldes", lat: -34.5842, lng: -58.7495 },
            { nombre: "Doctor René Favaloro y Asunción", lat: -34.5820, lng: -58.7470 },
            { nombre: "Astor Piazzolla y Solano López", lat: -34.5915, lng: -58.7590 },
            { nombre: "Manuel de Pinazo y Solano López", lat: -34.5920, lng: -58.7600 },
            { nombre: "Nini Marshall y Fray Luis León", lat: -34.5850, lng: -58.7460 },
            { nombre: "Olmedo y Moctezuma", lat: -34.5810, lng: -58.7450 }
            // Podés seguir agregando o manteniendo el listado completo aquí
        ];

        // Inicializar el mapa centrado en Trujui
        const map = L.map('map').setView([-34.5860, -58.7520], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        let marcadorOrigen = null;
        let marcadorDestino = null;

        function configurarBuscador(inputId, sugerenciasId, esOrigen) {
            const input = document.getElementById(inputId);
            const contenedorSugerencias = document.getElementById(sugerenciasId);

            input.addEventListener('input', function() {
                const texto = input.value.toLowerCase().trim();
                contenedorSugerencias.innerHTML = '';
                
                if (texto.length === 0) {
                    contenedorSugerencias.style.display = 'none';
                    return;
                }

                // Filtrar localmente en nuestras paradas de Trujui
                const filtradas = paradasTrujui.filter(p => p.nombre.toLowerCase().includes(texto));

                if (filtradas.length > 0) {
                    contenedorSugerencias.style.display = 'block';
                    filtradas.forEach(parada => {
                        const item = document.createElement('div');
                        item.className = 'sugerencia-item';
                        item.textContent = parada.nombre;
                        item.onclick = function() {
                            input.value = parada.nombre;
                            contenedorSugerencias.style.display = 'none';
                            
                            // Posicionar marcador en el mapa
                            const latLng = [parada.lat, parada.lng];
                            map.setView(latLng, 16);

                            if (esOrigen) {
                                if (marcadorOrigen) map.removeLayer(marcadorOrigen);
                                marcadorOrigen = L.marker(latLng, {
                                    icon: L.icon({
                                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
                                        iconSize: [25, 41], iconAnchor: [12, 41]
                                    })
                                }).addTo(map).bindPopup("Origen: " + parada.nombre).openPopup();
                            } else {
                                if (marcadorDestino) map.removeLayer(marcadorDestino);
                                marcadorDestino = L.marker(latLng, {
                                    icon: L.icon({
                                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
                                        iconSize: [25, 41], iconAnchor: [12, 41]
                                    })
                                }).addTo(map).bindPopup("Destino: " + parada.nombre).openPopup();
                            }
                        };
                        contenedorSugerencias.appendChild(item);
                    });
                } else {
                    contenedorSugerencias.style.display = 'none';
                }
            });

            // Ocultar sugerencias al hacer clic fuera
            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !contenedorSugerencias.contains(e.target)) {
                    contenedorSugerencias.style.display = 'none';
                }
            });
        }

        configurarBuscador('origen-input', 'origen-sugerencias', true);
        configurarBuscador('destino-input', 'destino-sugerencias', false);

        function confirmarViaje() {
            const origen = document.getElementById('origen-input').value;
            const destino = document.getElementById('destino-input').value;
            if (!origen || !destino) {
                alert("Por favor, selecciona un origen y un destino de la lista.");
                return;
            }
            alert("¡Viaje configurado con éxito en TuMovil!\nOrigen: " + origen + "\nDestino: " + destino);
        }
    </script>
</body>
</html>
