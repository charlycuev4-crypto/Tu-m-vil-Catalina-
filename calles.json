        // Inicializar el mapa centrado en Trujui
        const map = L.map('map').setView([-34.573, -58.770], 15);

        // Capa de mapa base (OpenStreetMap)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        const listContainer = document.getElementById('points-list');

        // Crear marcadores y elementos en la lista para TODOS los puntos
        locations.forEach((loc) => {
            // Usar dirección de "address" o "zona" dependiendo de cuál exista en el dato
            const addr = loc.address || loc.zona || "";
            // Usar descripción de "desc" o el nombre de "zona"
            const desc = loc.desc || loc.zona || "";

            // Añadir marcador al mapa
            const marker = L.marker([loc.lat, loc.lng]).addTo(map);
            marker.bindPopup(`<b>${loc.name}</b><br>${addr}<br><small>${desc}</small><br><small>Lat: ${loc.lat}, Lng: ${loc.lng}</small>`);

            // Crear elemento en el menú lateral
            const item = document.createElement('div');
            item.className = 'point-item';
            item.innerHTML = `
                <div class="point-title">${loc.name}</div>
                <div class="point-coords">${addr}</div>
                <div class="point-coords"><small>${desc} (${loc.lat}, ${loc.lng})</small></div>
            `;

            // Al hacer clic en el punto de la lista, centrar el mapa y abrir el popup
            item.addEventListener('click', () => {
                map.setView([loc.lat, loc.lng], 17);
                marker.openPopup();
            });

            listContainer.appendChild(item);
        });
