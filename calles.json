<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TuMovil - Panel de Control Familiar</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            display: flex;
            flex-direction: column;
            height: 100vh;
            background-color: #f4f4f9;
        }
        header {
            background-color: #00796b;
            color: white;
            padding: 15px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
        }
        #container {
            display: flex;
            flex: 1;
            flex-direction: column;
        }
        #map {
            flex: 1;
            width: 100%;
            min-height: 350px;
        }
        #sidebar {
            background: white;
            padding: 15px;
            overflow-y: auto;
            max-height: 40vh;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.1);
        }
        h3 {
            margin-bottom: 10px;
            color: #333;
            font-size: 1rem;
        }
        .point-item {
            padding: 10px;
            margin-bottom: 8px;
            background: #e0f2f1;
            border-left: 5px solid #00796b;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
        }
        .point-item:hover {
            background: #b2dfdb;
        }
        .point-title {
            font-weight: bold;
            color: #004d40;
            font-size: 0.95rem;
        }
        .point-coords {
            font-size: 0.8rem;
            color: #555;
        }
        @media (min-width: 768px) {
            #container {
                flex-direction: row;
            }
            #sidebar {
                width: 380px;
                max-height: none;
                height: 100%;
                box-shadow: -2px 0 5px rgba(0,0,0,0.1);
            }
        }
    </style>
</head>
<body>

    <header>🗺️ TuMovil - Panel de Control Familiar</header>

    <div id="container">
        <div id="sidebar">
            <h3>Puntos de Interés Registrados</h3>
            <div id="points-list"></div>
        </div>
        <div id="map"></div>
    </div>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // Listado unificado con los puntos anteriores y las nuevas esquinas añadidas
        const locations = [
            {
                name: "Comedor Luz de Damasco",
                address: "Pedro de Mendoza 105",
                lat: -34.577496,
                lng: -58.778685,
                desc: "Comedor social"
            },
            {
                name: "El buen hogar 24 hs",
                address: "Einstein y Pedro de Mendoza",
                lat: -34.577015,
                lng: -58.778104,
                desc: "Zona de restauración"
            },
            {
                name: "San Emilio",
                address: "San Emilio y Pedro de Mendoza",
                lat: -34.576407,
                lng: -58.777302,
                desc: "Punto marcado"
            },
            {
                name: "Namuncurá",
                address: "Namuncurá y Pedro de Mendoza",
                lat: -34.574900,
                lng: -58.775554,
                desc: "Punto marcado"
            },
            {
                name: "Intersección Magdalena",
                address: "Magdalena y Pedro de Mendoza",
                lat: -34.573781,
                lng: -58.774173,
                desc: "Intersección de calles"
            },
            {
                name: "Astor Piazzolla y Pedro de Mendoza",
                address: "Astor Piazzolla y Pedro de Mendoza",
                lat: -34.571765,
                lng: -58.773483,
                desc: "Cerca de Kiosco Tony"
            },
            {
                name: "Astor Piazzolla y Oribe",
                address: "Astor Piazzolla y Oribe",
                lat: -34.570984,
                lng: -58.772624,
                desc: "Cerca de Carnicería Nimia"
            },
            {
                name: "Manuel de Pinazo y Astor Piazzolla",
                address: "Manuel de Pinazo y Astor Piazzolla",
                lat: -34.570193,
                lng: -58.771801,
                desc: "Punto marcado"
            },
            {
                name: "Aeronáutica Argentina y Astor Piazzolla",
                address: "Aeronáutica Argentina y Astor Piazzolla",
                lat: -34.569454,
                lng: -58.770927,
                desc: "Cerca de Heladería El Buen Sabor"
            },
            {
                name: "Astor Piazzolla y Discépolo",
                address: "Astor Piazzolla y Discépolo",
                lat: -34.568674,
                lng: -58.770151,
                desc: "Cerca de Club Gimnasia de Santa Brígida"
            },
            {
                name: "Fray Luis León y C. Ricardo Güiraldes",
                address: "Fray Luis León y C. Ricardo Güiraldes",
                lat: -34.571614,
                lng: -58.774783,
                desc: "Esquina Fray Luis León[span_0](start_span)[span_0](end_span)"
            },
            {
                name: "C. Ricardo Güiraldes (Tramo)",
                address: "C. Ricardo Güiraldes",
                lat: -34.571030,
                lng: -58.774066,
                desc: "Punto intermedio[span_1](start_span)[span_1](end_span)"
            },
            {
                name: "Oribe y C. Ricardo Güiraldes",
                address: "Oribe y C. Ricardo Güiraldes",
                lat: -34.570399,
                lng: -58.773423,
                desc: "Esquina Oribe[span_2](start_span)[span_2](end_span)"
            },
            {
                name: "Puccini y C. Ricardo Güiraldes",
                address: "Puccini y C. Ricardo Güiraldes",
                lat: -34.569637,
                lng: -58.772609,
                desc: "Esquina Puccini / Manuel de Pinazo[span_3](start_span)[span_3](end_span)"
            },
            {
                name: "Aeronáutica Argentina y C. Ricardo Güiraldes",
                address: "Aeronáutica Argentina y C. Ricardo Güiraldes",
                lat: -34.568831,
                lng: -58.771767,
                desc: "Cerca de Estética E&E[span_4](start_span)[span_4](end_span)"
            },
            {
                name: "Discépolo y C. Ricardo Güiraldes",
                address: "Discépolo y C. Ricardo Güiraldes",
                lat: -34.568110,
                lng: -58.770920,
                desc: "Cerca de Herrería Arte Nacional[span_5](start_span)[span_5](end_span)"
            },
            {
                name: "Discépolo (Detalle)",
                address: "Discépolo 383",
                lat: -34.568315,
                lng: -58.770593,
                desc: "Punto sobre Discépolo[span_6](start_span)[span_6](end_span)"
            },
            {
                name: "La Amistad y C. Ricardo Güiraldes",
                address: "La Amistad y C. Ricardo Güiraldes",
                lat: -34.567830,
                lng: -58.770011,
                desc: "Cerca de Imprinting Sueños Vicky[span_7](start_span)[span_7](end_span)"
            },
            {
                name: "Murillo y C. Ricardo Güiraldes",
                address: "Murillo y C. Ricardo Güiraldes",
                lat: -34.567260,
                lng: -58.769437,
                desc: "Cerca de Carnicería Las Divas[span_8](start_span)[span_8](end_span)"
            }
        ];

        // Inicializar el mapa centrado en el primer punto
        const map = L.map('map').setView([locations[0].lat, locations[0].lng], 16);

        // Capa de mapa base (OpenStreetMap)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        const listContainer = document.getElementById('points-list');

        // Crear marcadores y elementos en la lista de forma dinámica
        locations.forEach((loc) => {
            const marker = L.marker([loc.lat, loc.lng]).addTo(map);
            marker.bindPopup(`<b>${loc.name}</b><br>${loc.address}<br><small>${loc.desc}</small><br><small>Lat: ${loc.lat}, Lng: ${loc.lng}</small>`);

            const item = document.createElement('div');
            item.className = 'point-item';
            item.innerHTML = `
                <div class="point-title">${loc.name}</div>
                <div class="point-coords">${loc.address}</div>
                <div class="point-coords"><small>${loc.desc} (${loc.lat}, ${loc.lng})</small></div>
            `;

            item.addEventListener('click', () => {
                map.setView([loc.lat, loc.lng], 18);
                marker.openPopup();
            });

            listContainer.appendChild(item);
        });
    </script>
</body>
</html>
