        // Inicializar mapa
        const map = L.map('map').setView([locations[0].lat, locations[0].lng], 16);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        const listContainer = document.getElementById('points-list');
        const searchBox = document.getElementById('search-box');
        
        let markers = [];

        // Función para renderizar los puntos (con soporte para filtrado)
        function renderLocations(filterText = "") {
            // Limpiar lista HTML y marcadores anteriores del mapa
            listContainer.innerHTML = "";
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            // Convertir texto de búsqueda a minúsculas para hacerlo insensible a mayúsculas/minúsculas
            const query = filterText.toLowerCase().trim();

            locations.forEach((loc) => {
                // Verificar si coincide con el nombre, dirección o descripción
                const matchName = loc.name.toLowerCase().includes(query);
                const matchAddress = loc.address.toLowerCase().includes(query);
                const matchDesc = loc.desc.toLowerCase().includes(query);

                if (matchName || matchAddress || matchDesc) {
                    const marker = L.marker([loc.lat, loc.lng]).addTo(map);
                    marker.bindPopup(`<b>${loc.name}</b><br>${loc.address}<br><small>${loc.desc}</small><br><small>Lat: ${loc.lat}, Lng: ${loc.lng}</small>`);
                    markers.push(marker);

                    const item = document.createElement('div');
                    item.className = 'point-item';
                    item.innerHTML = `
                        <div class="point-title">${loc.name}</div>
                        <div class="point-coords">${loc.address}</div>
                        <div class="point-coords"><small>${loc.desc} (${loc.lat}, ${loc.lng})</small></div>
                    `;

                    item.addEventListener('click', () => {
                        map.setView([loc.lat, loc.lng], 18);
                        marker.openPopup();
                    });

                    listContainer.appendChild(item);
                }
            });
        }

        // Cargar todos al inicio
        renderLocations();

        // Escuchar cuando el usuario escribe en el buscador (funciona igual con minúsculas y mayúsculas)
        searchBox.addEventListener('input', (e) => {
            renderLocations(e.target.value);
        });
