<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🗺️ TuMovil - Panel de Control Unificado (Trujui)</title>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }
        body {
            display: flex;
            flex-direction: column;
            height: 100vh;
            background-color: #f4f4f9;
        }
        header {
            background-color: #00796b;
            color: white;
            padding: 15px;
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
        }
        #container {
            display: flex;
            flex: 1;
            flex-direction: column;
        }
        #map {
            flex: 1;
            width: 100%;
            min-height: 300px;
        }
        #sidebar {
            background: white;
            padding: 15px;
            overflow-y: auto;
            max-height: 40vh; /* Panel lateral más pequeño en móvil */
            box-shadow: 0 -2px 5px rgba(0,0,0,0.1);
        }
        h3 {
            margin-bottom: 10px;
            color: #333;
            font-size: 1.1rem;
        }
        .point-item {
            padding: 10px;
            margin-bottom: 8px;
            background: #e0f2f1;
            border-left: 5px solid #00796b;
            cursor: pointer;
            border-radius: 4px;
            transition: background 0.2s;
        }
        .point-item:hover {
            background: #b2dfdb;
        }
        .point-title {
            font-weight: bold;
            color: #004d40;
            font-size: 0.95rem;
        }
        .point-coords {
            font-size: 0.8rem;
            color: #555;
            line-height: 1.3;
        }
        /* Estilo para PC */
        @media (min-width: 768px) {
            #container {
                flex-direction: row;
            }
            #sidebar {
                width: 420px;
                max-height: none;
                height: 100%;
                box-shadow: -2px 0 5px rgba(0,0,0,0.1);
            }
        }
    </style>
</head>
